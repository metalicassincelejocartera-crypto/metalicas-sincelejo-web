{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metalicas-sincelejo-web",
  "compatibility_date": "2026-10-06",
  // Genera dist/ (lee el catálogo de Firestore) antes de publicar
  "build": { "command": "node build.js" },
  // worker/index.js solo atiende la verificación de Google; lo demás va directo a dist/
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/google*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
